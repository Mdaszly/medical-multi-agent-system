{
  "info": {
    "name": "医院挂号预约系统API",
    "description": "基于Spring Boot的医院挂号预约系统接口文档，支持预约管理、号源查询、费用结算等功能",
    "version": "1.0.0",
    "schema": "https://Apifox.cn",
    "environment": {
      "development": {
        "baseUrl": "http://localhost:8080",
        "description": "开发环境"
      },
      "test": {
        "baseUrl": "http://localhost:8080",
        "description": "测试环境"
      }
    }
  },
  "categories": [
    {
      "name": "预约管理",
      "description": "预约挂号核心功能"
    },
    {
      "name": "排班管理",
      "description": "医生排班查询"
    },
    {
      "name": "认证管理",
      "description": "用户登录注册"
    }
  ],
  "apis": [
    {
      "name": "创建预约",
      "method": "POST",
      "path": "/api/appointment/create",
      "category": "预约管理",
      "description": "患者创建预约挂号",
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/json",
          "required": true
        },
        {
          "name": "satoken",
          "value": "{{satoken}}",
          "description": "登录后获取的Token",
          "required": true
        }
      ],
      "requestBody": {
        "scheduleId": 1,
        "timeSlot": "08:00-08:30",
        "remark": "首次就诊"
      },
      "requestBodySchema": {
        "type": "object",
        "properties": {
          "scheduleId": {
            "type": "long",
            "description": "排班ID",
            "required": true,
            "example": 1
          },
          "timeSlot": {
            "type": "string",
            "description": "预约时段，格式：HH:mm-HH:mm",
            "required": true,
            "example": "08:00-08:30"
          },
          "remark": {
            "type": "string",
            "description": "备注",
            "required": false,
            "example": "首次就诊"
          }
        }
      },
      "response": {
        "code": 20000,
        "message": "操作成功",
        "data": {
          "id": 1,
          "appointmentNo": "APT20260515100000123456",
          "userId": 6,
          "userName": "张三",
          "doctorId": 1,
          "doctorName": "李医生",
          "department": "心内科",
          "scheduleId": 1,
          "scheduleDate": "2026-05-16",
          "shiftType": "MORNING",
          "timeSlot": "08:00-08:30",
          "consultationFee": 20.0,
          "status": 0,
          "statusText": "待就诊",
          "checkInStatus": false,
          "createTime": "2026-05-15T10:00:00"
        }
      },
      "errorCodes": [
        {
          "code": 40000,
          "message": "参数错误",
          "examples": [
            {
              "scenario": "排班ID为空",
              "response": { "code": 40000, "message": "排班ID无效" }
            },
            {
              "scenario": "时段为空",
              "response": { "code": 40000, "message": "时段不能为空" }
            },
            {
              "scenario": "号源已满",
              "response": { "code": 40000, "message": "该时段已约满" }
            },
            {
              "scenario": "重复预约",
              "response": { "code": 40000, "message": "您已预约该时段" }
            }
          ]
        },
        {
          "code": 40100,
          "message": "未登录",
          "response": { "code": 40100, "message": "请先登录" }
        },
        {
          "code": 50000,
          "message": "系统错误",
          "examples": [
            {
              "scenario": "获取分布式锁失败",
              "response": { "code": 50000, "message": "系统繁忙，请稍后重试" }
            },
            {
              "scenario": "乐观锁更新失败",
              "response": { "code": 50000, "message": "号源已被占用，请重试" }
            }
          ]
        }
      ],
      "testCases": [
        {
          "name": "正常创建预约",
          "description": "用户登录后成功创建预约",
          "steps": [
            "1. 用户登录获取satoken",
            "2. 查询可预约的排班和号源",
            "3. 调用创建预约接口",
            "4. 验证返回预约信息"
          ],
          "expectedResult": "返回预约详情，状态为待就诊"
        },
        {
          "name": "号源已满",
          "description": "尝试预约已满的时段",
          "steps": [
            "1. 登录用户",
            "2. 查询到一个available_slots=0的时段",
            "3. 调用创建预约接口"
          ],
          "expectedResult": "返回错误：该时段已约满"
        },
        {
          "name": "重复预约",
          "description": "同一用户预约同时段",
          "steps": ["1. 用户已预约某时段", "2. 再次预约同一时段"],
          "expectedResult": "返回错误：您已预约该时段"
        }
      ]
    },
    {
      "name": "取消预约",
      "method": "POST",
      "path": "/api/appointment/cancel",
      "category": "预约管理",
      "description": "患者取消已预约的挂号",
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/json",
          "required": true
        },
        {
          "name": "satoken",
          "value": "{{satoken}}",
          "required": true
        }
      ],
      "requestBody": {
        "appointmentId": 1,
        "cancelReason": "时间冲突"
      },
      "requestBodySchema": {
        "type": "object",
        "properties": {
          "appointmentId": {
            "type": "long",
            "description": "预约ID",
            "required": true,
            "example": 1
          },
          "cancelReason": {
            "type": "string",
            "description": "取消原因",
            "required": false,
            "example": "时间冲突"
          }
        }
      },
      "response": {
        "code": 20000,
        "message": "操作成功",
        "data": null
      },
      "errorCodes": [
        {
          "code": 40000,
          "message": "参数错误",
          "examples": [
            {
              "scenario": "预约ID无效",
              "response": { "code": 40000, "message": "预约ID无效" }
            },
            {
              "scenario": "无权取消",
              "response": { "code": 40300, "message": "无权取消此预约" }
            },
            {
              "scenario": "状态不可取消",
              "response": { "code": 40000, "message": "该预约状态不可取消" }
            }
          ]
        }
      ]
    },
