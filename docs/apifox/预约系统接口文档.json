          "department": "心内科",
          "scheduleId": 1,
          "scheduleDate": "2026-05-16",
          "shiftType": "MORNING",
          "timeSlot": "08:00-08:30",
          "consultationFee": 20.0,
          "status": 0,
          "statusText": "待就诊",
          "checkInStatus": false,
          "createTime": "2026-05-15T10:00:00"
        }
      }
    },
