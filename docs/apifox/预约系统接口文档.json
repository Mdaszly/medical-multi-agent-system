      "queryParams": [
        {
          "name": "id",
          "type": "long",
          "description": "预约ID",
          "required": true,
          "example": 1
        }
      ],
      "response": {
        "code": 20000,
        "message": "操作成功",
        "data": {
          "id": 1,
