    {
      "name": "分页查询预约列表",
      "method": "POST",
      "path": "/api/appointment/list/page",
      "category": "预约管理",
      "description": "管理员分页查询预约列表",
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/json",
          "required": true
        },
        {
          "name": "satoken",
          "value": "{{satoken}}",
          "required": true
        }
      ],
      "requestBody": {
        "userId": null,
        "doctorId": null,
        "department": null,
        "scheduleDate": null,
        "status": null,
        "current": 1,
        "pageSize": 10
      },
      "requestBodySchema": {
        "type": "object",
        "properties": {
          "userId": { "type": "long", "description": "用户ID" },
          "doctorId": { "type": "long", "description": "医生ID" },
          "department": { "type": "string", "description": "科室" },
          "scheduleDate": { "type": "string", "description": "就诊日期" },
          "status": {
            "type": "int",
            "description": "状态：0-待就诊 1-已签到 2-诊疗中 3-已完成 4-已取消"
          },
          "current": { "type": "long", "description": "当前页", "default": 1 },
          "pageSize": { "type": "long", "description": "页大小", "default": 10 }
        }
      },
      "response": {
        "code": 20000,
        "message": "操作成功",
        "data": {
          "records": [],
          "total": 100,
          "size": 10,
          "current": 1,
          "pages": 10
        }
      }
    },
